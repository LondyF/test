require 'fileutils'
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '16.4'
ENV['RCT_NEW_ARCH_ENABLED'] = '1'
prepare_react_native_project!

date_picker_package = File.join(__dir__, '..', 'node_modules', 'react-native-date-picker', 'package.json')
if File.exist?(date_picker_package)
  contents = File.read(date_picker_package)
  contents.gsub!(
    /,\n\s+"modulesProvider": \{\n\s+"RNDatePicker": "RNDatePickerManager"\n\s+\}/,
    ''
  )
  File.write(date_picker_package, contents)
end

setup_permissions([
  'Camera',
  'FaceID',
  'LocationAccuracy',
  'LocationAlways',
  'LocationWhenInUse',
  'MediaLibrary',
  'Notifications',
  'PhotoLibrary',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end


target 'MiSaluMobileApp' do
  use_expo_modules!
  pod 'react-native-maps/Google', :path => '../node_modules/react-native-maps'

  post_integrate do |installer|
    begin
      expo_patch_react_imports!(installer)
    rescue => e
      Pod::UI.warn e
    end

    configure_project_script = File.join(
      __dir__,
      'Pods',
      'Target Support Files',
      'Pods-MiSaluMobileApp',
      'expo-configure-project.sh'
    )
    if File.exist?(configure_project_script)
      contents = File.read(configure_project_script)
      contents.gsub!(/^\s+--entitlement ".*MiSaluMobileApp\.entitlements" \\\n/, '')
      contents.gsub!(/^\s+\\\n(?=\s+--podfile-properties-file-path)/, '')
      File.write(configure_project_script, contents)
    end
  end

  config = use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => config[:reactNativePath],
    # Hermes is now enabled by default. Disable by setting this flag to false.
    :hermes_enabled => flags[:hermes_enabled],
    :fabric_enabled => flags[:fabric_enabled],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'MiSaluMobileAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
      # Keep pods aligned with Expo SDK 56's current minimum iOS target.
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
        # Ensure arm64 simulator builds are allowed (needed for iOS 26.0 simulators)
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FOLLY_HAS_COROUTINES=0'
      end
    end

    # Also remove simulator arm64 exclusion from generated xcconfig files
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.xcconfigs.each do |config_name, xcconfig|
        if xcconfig.attributes['EXCLUDED_ARCHS[sdk=iphonesimulator*]']
          xcconfig.attributes.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
          File.open(aggregate_target.xcconfig_path(config_name), 'w') { |out| out << xcconfig.to_s }
        end
      end
      if aggregate_target.respond_to?(:user_target_xcconfigs)
        aggregate_target.user_target_xcconfigs.each do |config_name, xcconfig|
          if xcconfig.attributes['EXCLUDED_ARCHS[sdk=iphonesimulator*]']
            xcconfig.attributes.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
            File.open(aggregate_target.user_target_xcconfig_path(config_name), 'w') { |out| out << xcconfig.to_s }
          end
        end
      end
    end

    # targetsToFix = ["React-Core-AccessibilityResources", "EXConstants-EXConstants"];
    # installer.generated_projects.each do |project|
    #   project.targets.each do |target|
    #     if targetsToFix.include? target.name
    #       puts "Set development team for target #{target.name}"
    #       target.build_configurations.each do |config|
    #         config.build_settings["DEVELOPMENT_TEAM"] = "L4TNJU92JY"
    #         config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution";
    #         config.build_settings["CODE_SIGN_STYLE"] = "Manual";
    #       end
    #     end
    #   end
    # end

    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    ['RCT-Folly', 'ReactNativeDependencies'].each do |folly_root|
      ['Expected.h', 'Optional.h'].each do |folly_header|
        header_path = File.join(__dir__, 'Pods', 'Headers', 'Public', folly_root, 'folly', folly_header)
        next unless File.exist?(header_path)

        File.chmod(0644, header_path)
        contents = File.read(header_path)
        contents.gsub!('#if FOLLY_HAS_COROUTINES', '#if 0 // FOLLY_HAS_COROUTINES')
        File.write(header_path, contents)
      end
    end

    expo_sqlite_root = File.join(__dir__, '..', 'node_modules', 'expo-sqlite')
    expo_sqlite_ios = File.join(expo_sqlite_root, 'ios')
    expo_sqlite_vendor = File.join(expo_sqlite_root, 'vendor', 'sqlite3')

    ['sqlite3.c', 'sqlite3.h'].each do |sqlite_file|
      source = File.join(expo_sqlite_vendor, sqlite_file)
      destination = File.join(expo_sqlite_ios, sqlite_file)
      FileUtils.cp(source, destination) if File.exist?(source)
    end

    # ExpoSQLite's vendored header uses SQLite's default include guard. When
    # the system SQLite header is imported first, Swift cannot see exsqlite3_*.
    [
      File.join(expo_sqlite_ios, 'sqlite3.h'),
      File.join(expo_sqlite_vendor, 'sqlite3.h')
    ].each do |sqlite_header|
      next unless File.exist?(sqlite_header)

      contents = File.read(sqlite_header)
      contents.sub!("#ifndef SQLITE3_H\n#define SQLITE3_H", "#ifndef EXPO_SQLITE3_H\n#define EXPO_SQLITE3_H")
      File.write(sqlite_header, contents)
    end

  end
end

target 'OneSignalNotificationServiceExtension' do
  pod 'OneSignalXCFramework', '>= 5.0.0', '< 6.0'
end


